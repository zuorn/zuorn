# =====================================================
#  Hexo 博客 .gitignore
# =====================================================

# ---------- 依赖与构建产物 ----------
node_modules/
public/
.deploy_git/

# ---------- Hexo 数据库 / 日志 ----------
db.json
*.log
npm-debug.log*
yarn-error.log*


# ---------- 系统与编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.user

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example
